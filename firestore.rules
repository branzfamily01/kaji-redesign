rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(hid) {
      return signedIn() && exists(/databases/$(database)/documents/households/$(hid)/access/$(request.auth.uid));
    }
    function isAdmin(hid) {
      return isMember(hid)
        && get(/databases/$(database)/documents/households/$(hid)/access/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{uid} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
      match /households/{hid} {
        allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
      }
    }

    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
                    && request.resource.data.householdId is string
                    && isMember(request.resource.data.householdId);
      allow update, delete: if signedIn() && isAdmin(resource.data.householdId);
    }

    match /households/{hid} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read: if isMember(hid);
      allow update, delete: if isAdmin(hid);

      match /access/{uid} {
        allow read: if isMember(hid) || (signedIn() && uid == request.auth.uid);
        allow create: if signedIn() && request.auth.uid == uid && (
          (get(/databases/$(database)/documents/households/$(hid)).data.ownerUid == request.auth.uid
            && request.resource.data.role == 'admin')
          ||
          (request.resource.data.role == 'member'
            && request.resource.data.inviteCode is string
            && exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode))
            && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.householdId == hid
            && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.active == true
            && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.expiresAt > request.time)
        );
        allow update, delete: if signedIn() && (request.auth.uid == uid || isAdmin(hid));
      }

      match /{collectionName}/{docId} {
        allow read, create, update, delete: if isMember(hid)
          && collectionName in ['members','tasks','completions','meta','devices'];
      }
    }
  }
}
